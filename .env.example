APP_NAME=omni-chan-storage
APP_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8082

DATABASE_URL=postgres://postgres:postgres@localhost:5432/omni_chan?sslmode=disable
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=2

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8082

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=omni-chan
MINIO_USE_SSL=false

JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_TTL=15m

INTERNAL_SERVICE_TOKEN=dev-internal-token
